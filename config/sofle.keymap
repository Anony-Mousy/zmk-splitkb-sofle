#include <dt-bindings/led/led.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/* Uncomment this block if using RGB */

&led_strip {
    // chain-length = <6>;

    chain-length = <36>; // Uncomment if using both per-key and underglow LEDs
    // chain-length = <72>;
    // chain-length = <29>; // Uncomment if using only per-key LEDs.
};

/*
    backlight: gpioleds {
        compatible = "gpio-leds";
        gpio_led_0 {
            gpios = <&arduino_header 12 GPIO_ACTIVE_HIGH>;
        };
    };
*/

/ {
    macros {
        macro_u_s_raise: macro_underglow_switcher_raise {
            display-name = "macro_underglow_switcher_raise";
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo RAISE>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(38,100,50)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo RAISE>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(265,100,50)>;
        };

        macro_u_s_lower: macro_underglow_switcher_lower {
            display-name = "macro_underglow_switcher_lower";
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo LOWER>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(125,100,50)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo LOWER>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(265,100,50)>;
        };
    };

    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };

        /*        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };*/
    };

    behaviors {
        rgb_encoder: rgb_encoder {
            compatible = "zmk,behaviour-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        rot_rgb: sensor_rotate_rgb {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&rgb_ug>, <&rgb_ug>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";

            // --------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2   |  3   |  4  |   5   |                   |   6   |  7    |  8    |  9   |   0   | TILDE |
            // |  TAB  |  Q  |  W   |  E   |  R  |   T   |                   |   Y   |  U    |  I    |  O   |   P   | MINUS |
            // |SH(TAB)|  A  |  S   |  D   |  F  |   G   |                   |   H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X   |  C   |  V  |   B   |  MUTE  |  | ENTER |   N   |  M    |  ,    |  .   |   /   | SHIFT |
            // --------------| CTRL | ALT  | GUI | LOWER |  SPACE |  | ENTER | RAISE | BKSPC | ALT   | CTRL |----------------
            //               --------------------------------------------------------------------------------

            bindings = <
&kp ESC      &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                                   &kp N6            &kp N7    &kp N8     &kp N9     &kp N0    &kp TILDE
&kp TAB      &kp Q   &kp W      &kp E     &kp R     &kp T                                    &kp Y             &kp U     &kp I      &kp O      &kp P     &kp MINUS
&kp LS(TAB)  &kp A   &kp S      &kp D     &kp F     &kp G                                    &kp H             &kp J     &kp K      &kp L      &kp SEMI  &kp SQT
&kp LSHFT    &kp Z   &kp X      &kp C     &kp V     &kp B             &kp C_MUTE    &kp RET  &kp N             &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                     &kp LCTRL  &kp LALT  &kp LGUI  &macro_u_s_lower  &kp SPACE     &kp RET  &macro_u_s_raise  &kp BSPC  &kp RALT   &kp RCTRL
            >;

            //                             Course Scrolling        Fine Scrolling

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp UP DOWN>;
        };

        lower_layer {
            display-name = "Lower";

            // ---------------------------------------------------------------------------------------------
            // | F1  | F2  | F3  | F4  | F5  | F6  |                   | F7  | F8  | F9  | F10 | F11 | F12 |
            // | F13 | F14 | F15 | F16 | F17 | F18 |                   | F19 | F20 | F21 | F22 | F23 | F24 |
            // |     |     |  =  |  +  |  \  |  |  |                   |  (  |  )  |  [  |  ]  |     |     |
            // |     |     |     |     |     |     |        |  |       |  {  |  }  |     |     |     |     |
            // ------------|     |     |     |     |        |  |       |     |     |     |     |------------
            //             ---------------------------------------------------------------------

            bindings = <
&kp F1   &kp F2   &kp F3     &kp F4    &kp F5    &kp F6                      &kp F7    &kp F8    &kp F9    &kp F10   &kp F11  &kp F12
&kp F13  &kp F14  &kp F15    &kp F16   &kp F17   &kp F18                     &kp F19   &kp F20   &kp F21   &kp F22   &kp F23  &kp F24
&trans   &trans   &kp EQUAL  &kp PLUS  &kp BSLH  &kp PIPE                    &kp LPAR  &kp RPAR  &kp LBKT  &kp RBKT  &trans   &trans
&trans   &trans   &trans     &trans    &trans    &trans    &trans    &trans  &kp LBRC  &kp RBRC  &trans    &trans    &trans   &trans
                  &trans     &trans    &trans    &trans    &trans    &trans  &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "Raise";

            // ------------------------------------------------------------------------------------------------------------
            // |       |      |      |       |       |      |                |      |      |       |      |       |       |
            // |       | INS  |      |   ^   |       | PGUP |                |      |      |       |      |       |       |
            // |       | DEL  |   <- |   v   |  ->   | PGDN |                |      |      |       |      |       |       |
            // |       |      |      |       |       |      |      |  |      |      |      |       |      |       |       |
            // ---------------|      |       |       |      |      |  |      |      |      |       |      |----------------
            //                -----------------------------------------------------------------------------

            bindings = <
&trans  &trans   &trans    &trans    &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp INS  &trans    &kp UP    &trans     &kp PG_UP                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp DEL  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans    &trans    &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                 &trans    &trans    &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "Adjust";

            // -----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |   BT1   |   BT2   |   BT3   |   BT4   |   BT5   |                   |      |      |       |      |       |       |
            // |        |         |         |         |         |         |                   |      |      |       |      |       |       |
            // |        | RGB_HUI |         | RGB_SAI |         |         |                   |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD |         | RGB_SAD |         | RGB_EFF | RGB_TOG |  |      |      |      |       |      |       |       |
            // -------------------|         |         |         |         |         |  |      |      |      |       |      |----------------
            //                    ------------------------------------------------------------------------------------------

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                               &none  &none  &none  &none  &none  &studio_unlock
&none              &none            &none            &none         &none         &none                                      &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &none         &none         &none                                      &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &none         &none         &rgb_ug RGB_EFF  &rgb_ug RGB_TOG    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none         &none         &none            &none              &none  &none  &none  &none  &none
            >;

            //            sensor-bindings = <&rgb_encoder &inc_dec_kp PG_UP PG_DN>;

            sensor-bindings = <&rot_rgb RGB_BRI RGB_BRD &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
